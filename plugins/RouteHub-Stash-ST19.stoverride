name: "RouteHub — проба ST19 (закрепление во времени, обёртка, команда по ссылке)"
desc: "Смотрит, держится ли закреплённый узел в fallback, уходит ли группа с мёртвого узла сама, и может ли ссылка из браузера переключить группу. Пишет только в тестовые группы без трафика. Обходной трафик не тратит."
author: "RouteHub"
category: "RouteHub"

# Установка одной ссылкой (открыть на телефоне):
# https://link.stash.ws/install-override/raw.githubusercontent.com/spxload/routehub/stash-client/plugins/RouteHub-Stash-ST19.stoverride
#
# ── ЗАЧЕМ ───────────────────────────────────────────────────────────────────
# ST18: скрипт закрепляет узел и в select, и в fallback. Неизвестно, что
# дальше: держится ли закрепление вечно (тогда fallback перестаёт сам уходить
# с упавшего узла) и есть ли способ без этого риска. ST19 смотрит это во
# времени — несколько прогонов подряд — и заодно проверяет, может ли страница
# в браузере командовать Stash через обычную ссылку.
#
# ── КАК ПОЛЬЗОВАТЬСЯ ────────────────────────────────────────────────────────
# 1. Выключить override ST18. Поставить этот (туннель Stash поднят).
# 2. Ничего не делать ~25 минут: проба идёт каждые 5 минут и сама проходит
#    фазы «старт → наблюдение → возврат → итог». Уведомление «ST19 ГОТОВО» —
#    конец; прислать выгрузку из журнала скриптов и выключить override.
# 3. Попутно (в любой момент): открыть в Safari http://rh-cmd.example.net/st19
#    и нажать обе кнопки. Нажать на уведомление ST19 — откроется ли та же
#    страница. Результат попадёт в следующую выгрузку.
# 4. По желанию: один раз переключиться Wi-Fi ↔ сотовая между прогонами —
#    проба увидит, сбрасывает ли смена сети ручной выбор в группе с ssid-policy.
#
# ── ЧТО ДОБАВЛЯЕТ (всё — в начало списков, так Stash сливает override) ──────
# Узел-муляж RH-Т19-Муляж (socks5 на 192.0.2.1 — адрес TEST-NET, никуда не
# ведёт, трафика нет) и 9 тестовых групп RH-Т19-*: членов-узлов в них нет,
# только DIRECT, муляж и они сами. Одно правило — для хоста перехватчика,
# напрямую. MITM не включается: перехват на обычном http, один хост.
#
# ── ЧТО ТРАТИТ ──────────────────────────────────────────────────────────────
# Почти ничего: запросы к локальному контроллеру; проверка здоровья тестовых
# групп раз в минуту — напрямую (DIRECT) и в пустоту (муляж).

proxies:
  - name: RH-Т19-Муляж
    type: socks5
    server: 192.0.2.1
    port: 1

proxy-groups:
  - name: RH-Т19-Прямо
    type: select
    proxies:
      - DIRECT
  - name: RH-Т19-Здоров
    type: fallback
    interval: 60
    proxies:
      - RH-Т19-Муляж
      - RH-Т19-Прямо
      - DIRECT
  - name: RH-Т19-Мёртв
    type: fallback
    interval: 60
    proxies:
      - RH-Т19-Прямо
      - RH-Т19-Муляж
      - DIRECT
  - name: RH-Т19-Ручной
    type: select
    proxies:
      - DIRECT
      - RH-Т19-Муляж
  - name: RH-Т19-Обёртка
    type: fallback
    interval: 60
    proxies:
      - RH-Т19-Ручной
      - RH-Т19-Прямо
  - name: RH-Т19-Скорость
    type: url-test
    interval: 60
    proxies:
      - RH-Т19-Прямо
      - DIRECT
  - name: RH-Т19-Баланс
    type: load-balance
    proxies:
      - RH-Т19-Прямо
      - DIRECT
  - name: RH-Т19-Сеть
    type: select
    proxies:
      - RH-Т19-Прямо
      - DIRECT
    ssid-policy:
      cellular: RH-Т19-Прямо
      default: DIRECT
  - name: RH-Т19-Команда
    type: select
    proxies:
      - RH-Т19-Прямо
      - DIRECT

rules:
  - DOMAIN,rh-cmd.example.net,DIRECT

http:
  force-http-engine:
    - rh-cmd.example.net:80
  script:
    - match: ^http://rh-cmd\.example\.net/st19
      name: rh-st19-cmd
      type: request
      require-body: false
      timeout: 10

script-providers:
  rh-st19:
    url: https://raw.githubusercontent.com/spxload/routehub/stash-client/probes/routehub-probe-stash19.js
    interval: 300
  rh-st19-cmd:
    url: https://raw.githubusercontent.com/spxload/routehub/stash-client/probes/routehub-probe-stash19-cmd.js
    interval: 300

cron:
  script:
    - name: rh-st19
      cron: '*/5 * * * *'
      timeout: 300
