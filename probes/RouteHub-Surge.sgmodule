#!name = RouteHub — пробы возможностей Surge (SG1 + SG2)
#!desc = Две плитки на главном экране: SG1 — опись среды и карта локального HTTP API, SG2 — чтение тел ключевых эндпоинтов. ТОЛЬКО ЧТЕНИЕ: политики не меняются, MITM не включается, через обходные узлы трафик не идёт. Ставится на семь дней пробного периода, потом удаляется.
#!category = RouteHub

# ── КАК ПОЛЬЗОВАТЬСЯ (всё с телефона) ─────────────────────────────────────
#
# 1. Surge → Модули (Modules) → «+» → Установить из URL:
#    https://raw.githubusercontent.com/spxload/routehub/main/probes/RouteHub-Surge.sgmodule
#
# 2. На главном экране Surge появятся две плитки: «RouteHub SG1» и
#    «RouteHub SG2». Нажать — проба отработает и покажет сводку на плитке.
#
# 3. Полный отчёт (JSON) — в Surge → Больше (More) → Журнал (Log). Оттуда его
#    можно скопировать и прислать в чат.
#
# ВАЖНО: конфиг профиля руками править НЕ НУЖНО. Всё, что нужно пробам,
# объявлено здесь. Если строка скрипта всё-таки вписывается в профиль
# вручную, `script-path=` обязан содержать адрес — пустое значение Surge
# отвергает («Invalid line … script-path=»), и весь профиль не загружается.
#
# ── КЛЮЧ HTTP API ─────────────────────────────────────────────────────────
#
# SG1 без ключа покажет только «слушает / не слушает» (ответ 401 — это уже
# доказательство, что API поднят). SG2 без ключа не покажет почти ничего:
# ей нужны тела ответов.
#
#   а) Surge → Профиль → редактировать, в секцию [General] добавить строку:
#          http-api = ПРИДУМАННЫЙ_КЛЮЧ@0.0.0.0:6171
#      и сохранить. Ключ придумывается любой, это пароль к API.
#
#   б) В строках ниже заменить СВОЙ_КЛЮЧ на тот же ключ. Обе строки.
#
# Ключ никуда не отправляется и в отчёт не попадает — пробы его маскируют
# наравне с токенами и паролями.
#
# ВНИМАНИЕ. Строка `http-api` открывает управление Surge всем, кто есть в той
# же сети Wi-Fi. На время пробы это приемлемо, в чужих сетях — нет. После
# семи дней строку убрать.
#
# ── АРГУМЕНТЫ ─────────────────────────────────────────────────────────────
# Несколько аргументов через «&», например: argument=apikey=abc&full=1
#
#   SG1:  full=1   выгрузить ВСЕ глобальные имена, а не сводку (отчёт длинный)
#         port=…   дополнительный порт помимо 6171, 6152, 8080
#         post=1   отправить отчёт на приёмник стенда (по умолчанию выключено)
#   SG2:  hosts=…  сколько имён хостов показать (по умолчанию 40)
#         raw=1    не обрезать тела ответов (отчёт станет очень длинным)

[Panel]
RouteHub-SG1 = script-name=RouteHub-SG1, update-interval=-1
RouteHub-SG2 = script-name=RouteHub-SG2, update-interval=-1

[Script]
# SG1 — опись среды и карта путей API. Нажатие на плитку запускает вручную.
RouteHub-SG1 = type=generic, script-path=https://raw.githubusercontent.com/spxload/routehub/main/probes/routehub-probe-surge.js, timeout=40, argument=apikey=СВОЙ_КЛЮЧ

# SG2 — чтение тел ключевых эндпоинтов: имена хостов в журнале запросов,
# состав групп и есть ли среди них smart, сколько видно узлов, что умеет
# $httpAPI. Ключ обязателен.
RouteHub-SG2 = type=generic, script-path=https://raw.githubusercontent.com/spxload/routehub/main/probes/routehub-probe-surge2.js, timeout=40, argument=apikey=СВОЙ_КЛЮЧ

# Ежедневный прогон SG1 в 04:10 — чтобы за семь дней набралась история, если
# что-то в Surge меняется от версии к версии. Не обязателен: строку можно
# закомментировать, проба останется доступна плиткой.
RouteHub-SG1-cron = type=cron, cronexp="10 4 * * *", script-path=https://raw.githubusercontent.com/spxload/routehub/main/probes/routehub-probe-surge.js, timeout=40, wake-system=false, argument=apikey=СВОЙ_КЛЮЧ

[MITM]
# Ничего. Пробы принципиально не требуют MITM.
