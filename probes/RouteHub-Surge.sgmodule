#!name = RouteHub — проба возможностей Surge (SG1)
#!desc = Опись среды Surge и карта локального HTTP API. ТОЛЬКО ЧТЕНИЕ: не меняет политики, не трогает MITM, не гоняет трафик через обходные узлы. Ставится на семь дней пробного периода, потом удаляется.
#!category = RouteHub

# ── КАК ПОЛЬЗОВАТЬСЯ (всё с телефона) ─────────────────────────────────────
#
# 1. Surge → Модули (Modules) → «+» → Установить из URL:
#    https://raw.githubusercontent.com/spxload/routehub/main/probes/RouteHub-Surge.sgmodule
#
# 2. На главном экране Surge появится плитка «RouteHub SG1». Нажать — проба
#    отработает и покажет сводку прямо на плитке.
#
# 3. Полный отчёт (JSON) — в Surge → Больше (More) → Журнал (Log). Оттуда его
#    можно скопировать и прислать в чат.
#
# ── ЧТОБЫ УВИДЕТЬ КАРТУ HTTP API ──────────────────────────────────────────
#
# Без ключа проба покажет только «слушает / не слушает» (ответ 401 — это уже
# доказательство, что API поднят). Чтобы получить карту путей целиком, надо
# включить API в профиле Surge и передать ключ пробе.
#
#   а) Surge → Профиль → редактировать, в секцию [General] добавить строку:
#          http-api = ПРИДУМАННЫЙ_КЛЮЧ@0.0.0.0:6171
#      и сохранить. Ключ придумывается любой, это пароль к API.
#
#   б) В этом модуле ниже, в строке panel и в строке cron, к argument
#      дописать свой ключ:  argument=apikey=ПРИДУМАННЫЙ_КЛЮЧ
#
# Ключ никуда не отправляется и в отчёт не попадает — проба его маскирует
# наравне с токенами и паролями.
#
# ВНИМАНИЕ. Строка `http-api` открывает управление Surge всем, кто есть в той
# же сети Wi-Fi. На время пробы это приемлемо, в чужих сетях — нет. После
# семи дней строку убрать.
#
# ── АРГУМЕНТЫ ПРОБЫ ───────────────────────────────────────────────────────
#   full=1        выгрузить ВСЕ глобальные имена, а не сводку (отчёт длинный)
#   apikey=…      ключ HTTP API
#   port=…        дополнительный порт помимо 6171, 6152, 8080
#   post=1        отправить отчёт на приёмник стенда (по умолчанию выключено)
# Несколько аргументов через «&»: argument=apikey=abc&full=1

[Panel]
RouteHub-SG1 = script-name=RouteHub-SG1, update-interval=-1

[Script]
# Плитка на главном экране: нажатие запускает пробу вручную.
RouteHub-SG1 = type=generic, script-path=https://raw.githubusercontent.com/spxload/routehub/main/probes/routehub-probe-surge.js, timeout=40, argument=

# Ежедневный прогон в 04:10 — чтобы за семь дней набралась история, если
# что-то в Surge меняется от версии к версии. Не обязателен: строку можно
# закомментировать, проба останется доступна плиткой.
[Script]
RouteHub-SG1-cron = type=cron, cronexp="10 4 * * *", script-path=https://raw.githubusercontent.com/spxload/routehub/main/probes/routehub-probe-surge.js, timeout=40, wake-system=false, argument=

[MITM]
# Ничего. Проба принципиально не требует MITM.
